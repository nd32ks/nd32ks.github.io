---
// Phosphor Light icons, inlined so they inherit currentColor.
import arrowDown from '@phosphor-icons/core/assets/light/arrow-down-light.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/light/arrow-up-right-light.svg?raw';
import envelope from '@phosphor-icons/core/assets/light/envelope-simple-light.svg?raw';
import github from '@phosphor-icons/core/assets/light/github-logo-light.svg?raw';
import list from '@phosphor-icons/core/assets/light/list-light.svg?raw';
import moon from '@phosphor-icons/core/assets/light/moon-light.svg?raw';
import sun from '@phosphor-icons/core/assets/light/sun-light.svg?raw';
import x from '@phosphor-icons/core/assets/light/x-light.svg?raw';

const icons = { arrowDown, arrowUpRight, envelope, github, list, moon, sun, x };

interface Props { name: keyof typeof icons; size?: number; class?: string }
const { name, size = 18, class: cls } = Astro.props;
const svg = icons[name].replace('<svg ', `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" `);
---
<span class:list={['icon', cls]} set:html={svg} />
