---
import Icon from './Icon.astro';
import { dict, type Lang } from '../i18n';
import { skills, proofProjects, shippedProof } from '../data/proof';

interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
const c = dict[lang];
const today = new Date().toISOString().slice(0, 10);
const status = (start: string, due: string, repo: string) => (today < start ? 'next' : today <= due ? 'live' : repo ? 'done' : 'review');
const statusLabel = { live: c.statusLive, next: c.statusNext, done: c.statusDone, review: c.statusReview } as const;
const fmt = (iso: string) => {
  const d = new Date(iso + 'T00:00:00Z');
  return zh ? `${d.getUTCMonth() + 1}月${d.getUTCDate()}日` : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
};
const skillName = Object.fromEntries(skills.map((s) => [s.id, zh ? s.zh : s.en]));
const shape: [number, number][] = [[14, 64], [36, 32], [58, 56], [78, 22], [90, 68]];
const h2 = zh ? '每周项目计划' : 'Weekly project schedule';
const sub = zh ? '在毕业项目之前，每周完成一个项目。选择一项技能，查看哪些项目会用到它。' : 'One project is due each week until the capstone. Select a skill to see which projects use it.';
---
<section id="proof" class="section proof" data-proof>
  <div class="proof-head">
    <h2 data-split>{h2}</h2>
    <p data-reveal>{sub}</p>
  </div>
  <div class="skill-pick" role="group" aria-label={c.proofH} data-reveal>
    <button type="button" class="skill-btn" data-skill="" aria-pressed="true">{c.proofAll}</button>
    {skills.map((s) => <button type="button" class="skill-btn" data-skill={s.id} aria-pressed="false">{zh ? s.zh : s.en}</button>)}
  </div>
  <p class="shipped" data-reveal>
    <span>{c.proofShipped}</span>
    {shippedProof.map((s) => <a href={s.href} data-skills={s.skills.join(' ')}>{s.title}</a>)}
  </p>
  <ol class="weeks">
    {proofProjects.map((p, i) => {
      const st = status(p.start, p.due, p.repo);
      const lit = st === 'done' ? 5 : st === 'live' || st === 'review' ? 3 : 0;
      return (
        <li class="week" data-pass data-skills={p.skills.join(' ')} data-start={p.start} data-due={p.due} data-has-repo={p.repo ? '1' : ''} style={`--i:${i}`}>
          <article class="bezel">
            <div class="bezel-core week-core">
              <div class="mini" aria-hidden="true">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                  {shape.slice(1).map((pt, j) => <line x1={shape[j][0]} y1={shape[j][1]} x2={pt[0]} y2={pt[1]} class:list={{ on: j + 1 < lit }} vector-effect="non-scaling-stroke" />)}
                </svg>
                {shape.map((pt, j) => <span class:list={['mini-star', { on: j < lit }]} style={`left:${pt[0]}%;top:${pt[1]}%`}></span>)}
              </div>
              <div class="week-top">
                <span class="week-n">{String(i + 1).padStart(2, '0')} · {fmt(p.start)} - {fmt(p.due)}</span>
                <span class={`pass-status s-${st}`} data-status data-l-live={c.statusLive} data-l-next={c.statusNext} data-l-done={c.statusDone} data-l-review={c.statusReview}>{statusLabel[st]}</span>
              </div>
              <h3>{p[lang].title}</h3>
              <p>{p[lang].desc}</p>
              <ul class="chips chips-sm">{p.skills.map((s) => <li data-chip={s}>{skillName[s]}</li>)}</ul>
              <div class="week-links">
                {p.repo
                  ? <a class="btn btn-ghost btn-sm" href={p.repo} rel="noopener">{c.repo}<span class="btn-ico"><Icon name="github" size={14} /></span></a>
                  : <span class="link-soon"><Icon name="github" size={16} />{c.soon}</span>}
                {p.writeup && <a class="text-link" href={p.writeup} rel="noopener">{c.writeup}<Icon name="arrowUpRight" size={14} /></a>}
              </div>
            </div>
          </article>
        </li>
      );
    })}
  </ol>
</section>
