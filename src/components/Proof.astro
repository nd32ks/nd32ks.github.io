---
import Icon from './Icon.astro';
import { dict, type Lang } from '../i18n';
import { skills, proofProjects, shippedProof, type Viz } from '../data/proof';

interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
const c = dict[lang];
const skillName = Object.fromEntries(skills.map((s) => [s.id, zh ? s.zh : s.en]));
const h2 = zh ? '数据科学项目' : 'Data science projects';
const sub = zh ? '五个端到端分析项目，每个都附代码和报告。选择一项技能，查看用到它的项目。' : 'Five end-to-end analyses, each with code and a write-up. Select a skill to see the projects that use it.';
const codeLabel = zh ? '代码' : 'Code';
const writeupLabel = zh ? '报告' : 'Write-up';
const placeholderNote = zh ? '链接待添加' : 'Link to be added';

// Small diagrams of the method each project uses (illustrative, not results).
let seed = 9;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const series = Array.from({ length: 40 }, (_, i) => [8 + i * 7.8, i === 27 ? 28 : 96 + Math.sin(i / 4) * 14 + (rnd() - 0.5) * 18] as const);
const bell = (mu: number, sd: number, h: number) => Array.from({ length: 61 }, (_, i) => { const x = i / 60; return [10 + x * 300, 160 - h * Math.exp(-((x - mu) ** 2) / (2 * sd * sd))] as const; });
const path = (pts: readonly (readonly [number, number])[]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const viz: Record<Viz, string> = {
  funnel: [100, 76, 54, 34, 20].map((w, i) => `<rect x="${160 - w * 1.4}" y="${22 + i * 28}" width="${w * 2.8}" height="18" rx="9" class="${i === 4 ? 'v-hot' : 'v-fill'}" />`).join(''),
  anomaly: `<path d="${path(series)}" class="v-line" /><circle cx="${series[27][0]}" cy="28" r="7" class="v-hot" /><circle cx="${series[27][0]}" cy="28" r="15" class="v-ring" />`,
  threshold: `<path d="${path(bell(0.33, 0.12, 120))}" class="v-line" /><path d="${path(bell(0.66, 0.13, 90))}" class="v-line v-hot-line" /><line x1="170" y1="20" x2="170" y2="166" class="v-dash" />`,
  ab: `<line x1="40" y1="60" x2="300" y2="60" class="v-axis" /><line x1="40" y1="120" x2="300" y2="120" class="v-axis" /><line x1="90" y1="60" x2="190" y2="60" class="v-ci" /><circle cx="140" cy="60" r="8" class="v-fill" /><line x1="150" y1="120" x2="260" y2="120" class="v-ci v-hot-line" /><circle cx="205" cy="120" r="8" class="v-hot" /><text x="14" y="65" class="v-label">A</text><text x="14" y="125" class="v-label">B</text>`,
  capstone: (() => { const n = [[50, 120], [110, 56], [170, 110], [230, 44], [280, 128]]; return n.slice(1).map((p, i) => `<line x1="${n[i][0]}" y1="${n[i][1]}" x2="${p[0]}" y2="${p[1]}" class="v-dash" />`).join('') + n.map((p, i) => `<circle cx="${p[0]}" cy="${p[1]}" r="${i === 4 ? 10 : 6}" class="${i === 4 ? 'v-hot' : 'v-fill'}" />`).join(''); })(),
};
---
<section id="proof" class="section proof" data-proof>
  <div class="proof-head">
    <h2 data-split>{h2}</h2>
    <p data-reveal>{sub}</p>
  </div>
  <div class="skill-pick" role="group" aria-label={c.proofH} data-reveal>
    <button type="button" class="skill-btn" data-skill="" aria-pressed="true">{c.proofAll}</button>
    {skills.map((s) => <button type="button" class="skill-btn" data-skill={s.id} aria-pressed="false">{zh ? s.zh : s.en}</button>)}
  </div>
  <p class="shipped" data-reveal>
    <span>{c.proofShipped}</span>
    {shippedProof.map((s) => <a href={s.href} data-skills={s.skills.join(' ')}>{s.title}</a>)}
  </p>
  <ol class="projects">
    {proofProjects.map((p, i) => (
      <li class:list={['project', { wide: i < 2 }]} data-pass data-skills={p.skills.join(' ')} style={`--i:${i}`}>
        <article class="bezel">
          <div class="bezel-core project-core">
            <div class="project-viz" aria-hidden="true">
              <svg viewBox="0 0 320 180" preserveAspectRatio="xMidYMid meet" set:html={viz[p.viz]} />
              <span class="project-n">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="project-body">
              <h3>{p[lang].title}</h3>
              <p>{p[lang].desc}</p>
              <ul class="chips chips-sm">{p.skills.map((s) => <li data-chip={s}>{skillName[s]}</li>)}</ul>
              <div class="project-links">
                <a class:list={['btn', 'btn-ghost', 'btn-sm', { placeholder: !p.repo }]} href={p.repo || '#proof'} rel={p.repo ? 'noopener' : undefined} target={p.repo ? '_blank' : undefined} aria-disabled={p.repo ? undefined : 'true'} title={p.repo ? undefined : placeholderNote}>
                  {codeLabel}<span class="btn-ico"><Icon name="github" size={14} /></span>
                </a>
                <a class:list={['btn', 'btn-ghost', 'btn-sm', { placeholder: !p.writeup }]} href={p.writeup || '#proof'} rel={p.writeup ? 'noopener' : undefined} target={p.writeup ? '_blank' : undefined} aria-disabled={p.writeup ? undefined : 'true'} title={p.writeup ? undefined : placeholderNote}>
                  {writeupLabel}<span class="btn-ico"><Icon name="arrowUpRight" size={14} /></span>
                </a>
              </div>
            </div>
          </div>
        </article>
      </li>
    ))}
  </ol>
</section>
